# Copy to backend/.env (gitignored). The backend reads it with python-dotenv (via pydantic-settings).
# Keys live ONLY in that file. Never `export ANTHROPIC_API_KEY` in your shell or ~/.bashrc:
# Claude Code would then bill the API key instead of your subscription.
# Everything except the two API keys has a working local default, so you can omit those lines.

# --- LLM agent (Anthropic Messages API with tool use) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- TTS (OpenAI /v1/audio/speech) ---
OPENAI_API_KEY=
# Current Speech API model as of 2026-11-23. OpenAI has marked it deprecated with shutdown
# scheduled for 2027-01-06, after this demo. Re-check the docs if you reuse this later.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Two distinct built-in voices: agent = business side, customer = scripted human side.
TTS_VOICE_AGENT=marin
TTS_VOICE_CUSTOMER=cedar

# --- Database: Postgres 16 from docker-compose.yml on host port 5433 ---
DATABASE_URL=postgresql+asyncpg://simpleai:simpleai@localhost:5433/simpleai

# --- Link page ---
# The texted link is {PUBLIC_BASE_URL}/s/{token}. Default is the Vite dev server.
PUBLIC_BASE_URL=http://localhost:5173
LINK_TTL_MINUTES=30

# --- Dev only (not in CLAUDE.md) ---
# Mounts /api/dev/* (create a call, emit an arbitrary event). Set false outside local dev.
ENABLE_DEV_ROUTES=true
